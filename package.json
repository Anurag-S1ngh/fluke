{
  "name": "fluke",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "dev:worker": "turbo run dev -F worker --",
    "db:push": "turbo run db:push -F @fluke/db --",
    "db:test:push": "cd packages/db && NODE_ENV=test bun run db:push",
    "db:studio": "turbo run db:studio -F @fluke/db --",
    "db:generate": "turbo run db:generate -F @fluke/db --",
    "db:migrate": "turbo run db:migrate -F @fluke/db --",
    "test": "turbo run test",
    "compose:up": "docker compose -f docker/compose.yaml up -d --wait",
    "compose:down": "docker compose -f docker/compose.yaml down",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/worker/ && varlock codegen --path ./packages/db/ && varlock codegen --path ./packages/redis/ && varlock codegen --path ./packages/email/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/worker/ && varlock codegen --path ./packages/db/ && varlock codegen --path ./packages/redis/ && varlock codegen --path ./packages/email/",
    "check": "oxlint && oxfmt --write",
    "format": "oxfmt --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fluke/config": "workspace:*",
    "@types/bun": "catalog:",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "packageManager": "bun@1.4.0"
}
